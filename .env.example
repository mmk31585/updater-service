# Application
APP_NAME=node-service
APP_ENV=development
GIN_MODE=debug

# Elasticsearch
ELASTIC_ENABLED=true
ELASTIC_URL=http://localhost:9200
ELASTIC_INDEX=operations-v1

# Only needed for a cluster with xpack.security enabled, which rejects every
# unauthenticated request. Leave both empty for an unsecured cluster: no header
# is sent at all in that case.
#
# Note these have no defaults, deliberately. They used to default to
# "elastic"/"changeme", which meant a placeholder was transmitted to every
# cluster and a real password was one edit away from being committed here.
# Set both, or neither. A username without a password sends no header, because
# the client treats that as no credentials.
# ELASTIC_USER=
# ELASTIC_PASSWORD=

# Certificate verification for the Elasticsearch client. TRUE BY DEFAULT, so a
# self-signed or private-CA cluster works with no configuration, and matching
# MISP_TLS_SKIP_VERIFY so the two clusters have one posture.
#
# Be aware what that means. With this on, the connection still looks encrypted
# but nothing proves the peer is the cluster, so anyone able to intercept the
# path could read ELASTIC_PASSWORD and tamper with indexed operations.
#
# Prefer ELASTIC_CA_CERT below and setting this to false.
# ELASTIC_TLS_SKIP_VERIFY=true

# Path to a PEM bundle to trust the cluster certificate. THE BETTER OPTION than
# skipping verification above: it keeps verification on. Use this for a private
# or internal CA, then set ELASTIC_TLS_SKIP_VERIFY=false. Only read when
# ELASTIC_URL is https, so it is inert otherwise. A missing, empty or unusable
# file is reported at startup with its path.
# ELASTIC_CA_CERT=/etc/ssl/certs/es-ca.pem

ELASTIC_WORKERS=2
ELASTIC_CHANNEL_CAP=1000
ELASTIC_FLUSH_BYTES=5242880
ELASTIC_FLUSH_INTERVAL=5s
ELASTIC_MAX_RETRIES=5
ELASTIC_DLQ_PATH=/tmp/update/es-dead-letter

# HTTP Server
HTTP_HOST=localhost
HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# The public address of this API, used for the host, basePath and schemes of
# the served OpenAPI document. Without it the document still advertises
# localhost:8080 from build time, so the Swagger UI's "Try it out" and any
# generated client would call localhost instead of this deployment.
#
# A scheme and path are optional: "api.example.com" replaces only the host and
# keeps the generated schemes, while "https://api.example.com/updater" sets all
# three. Credentials, a query or a fragment are refused, because the document is
# served to anyone who can read it.
#
# This is the CLIENT-FACING address. INTERNAL_BASE_URL is different: it is the
# address a worker uses to download artifacts, which may be an internal name and
# should not be advertised in the public documentation. Leave this empty when
# running locally; the entry service warns at startup if it is missing in
# production.
# SWAGGER_BASE_URL=https://api.example.com

# Database (MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=file_service
DB_USER=app
DB_PASSWORD=secret
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=5s

# NATS
# Leave NATS_URL without credentials and set the two below when the broker
# requires auth. Credentials embedded in the URL still work, but they appear
# in `docker inspect` and in the env file, so the separate variables are
# preferred. Setting NATS_PASSWORD without NATS_USERNAME is rejected at
# startup, because the broker would otherwise fail every connection and the
# only symptom would be a reconnect loop in the logs.
NATS_URL=nats://localhost:4222
NATS_USERNAME=
NATS_PASSWORD=
NATS_CONNECT_TIMEOUT=5s
NATS_RECONNECT_WAIT=2s
NATS_MAX_RECONNECTS=-1
NATS_DRAIN_TIMEOUT=10s
NATS_STREAM_NAME=FILE_SERVICE

# Both binaries wait for the broker at startup rather than exiting on the first
# failure, so a broker that comes up a second later is a wait and not a crash
# loop. The defaults are 15 attempts 2s apart, about 30 seconds. A lost
# connection after startup is retried on NATS_RECONNECT_WAIT up to
# NATS_MAX_RECONNECTS times, and each disconnect, retry failure and reconnect is
# logged; without that a reconnect loop was indistinguishable from an idle
# service.

# Node
NODE_ID=node-1
NODE_ROLE=entry
NODE_HEARTBEAT_INTERVAL=5s
NODE_HEARTBEAT_TIMEOUT=15s

# File Transfer
FILE_STAGING_DIR=./data/transfers
FILE_CHUNK_SIZE=1MiB
FILE_MAX_SIZE=20GiB
FILE_TRANSFER_TIMEOUT=30m
FILE_CHUNK_ACK_TIMEOUT=10s
FILE_TUSD_UPLOAD_DIR=./data/uploads
FILE_TUSD_MAX_SIZE=20GiB
FILE_TUSD_BASE_PATH=/uploads
FILE_TUSD_NOTIFY_TIMEOUT=10s
FILE_DOWNLOAD_CONCURRENCY=4
FILE_DOWNLOAD_CHUNK_SIZE=64MiB
FILE_DOWNLOAD_MAX_RETRIES=3

# Operation
OPERATION_TIMEOUT=30m
COMMAND_ACK_TIMEOUT=10s
PROCESSING_TIMEOUT=10m

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Services
SERVICES_ROOT=/app/services
# Optional per-service health URL overrides. The defaults address each service by
# name on the container network (e.g. http://data-service:8080/health), which is
# what the worker uses when it runs as a container alongside the service.
# A host-published port such as 8081 is NOT reachable that way, so set an override
# when the worker runs outside Docker:
# HEALTH_URL_DATA_SERVICE=http://localhost:8081/health
# The two services without a default (config-service, test-service) always need one.

# Health Check
HEALTH_CHECK_TIMEOUT=15s
HEALTH_REQUEST_TIMEOUT=2s
RETRY_INITIAL_DELAY=1s
RETRY_MAX_DELAY=4s
MAX_HEALTH_RETRIES=3
HEALTH_CHECK_INTERVAL=0

# Worker health endpoint
HEALTH_ADDR_PORT=8081

# Base URL workers use to download artifacts (GET /internal/operations/{id}/file).
# Host run (go run ./cmd/worker): localhost. Docker Compose overrides this with
# http://entry:8080.
INTERNAL_BASE_URL=http://localhost:8080

# MISP feed deployment (worker only).
# Leave these unset to keep the worker on its generic behaviour; setting only
# some of them is rejected at startup.
# MISP_API_URL=https://misp.example.com
# MISP_AUTH_API_KEY=<api key, never logged>
# Stable identity of the feed the worker owns. MISP requires a provider when
# the feed has to be created.
# MISP_FEED_NAME=updater-feeds
# MISP_FEED_PROVIDER=updater
# Host-side directory the worker owns and replaces. It must live on the same
# filesystem as its parent so the staging-to-output swap can use rename(2).
# MISP_OUTPUT_PATH=/opt/misp/files/output
# Path MISP itself reads. This is the in-container view of MISP_OUTPUT_PATH and
# is not the same path unless the deployment maps them that way.
# MISP_FEED_URL=/var/www/MISP/app/files/output
# uid:gid applied to the deployed tree. 33:33 is the usual Debian www-data
# pair; confirm with `id www-data` in the MISP environment before relying on it.
# MISP_OUTPUT_OWNER=33:33
# Optional MISP feed fields, only sent when set.
# MISP_FEED_DISTRIBUTION=0
# MISP_FEED_DELTA_MERGE=

# --- MISP timeouts ------------------------------------------------------------
# MISP imports a feed in the background: fetchFromFeed only queues the work, so
# the deployment waits and polls until the events show up in MISP.

# Ceiling for a single MISP API call. A feed fetch that imports thousands of
# events is itself long, so this is per request, not for the whole operation.
# MISP_API_TIMEOUT=60s

# Certificate verification for the MISP API client. TRUE BY DEFAULT, so a
# self-signed or internal-CA instance works with no configuration.
#
# Be aware what that means. With this on, the connection still looks encrypted
# but nothing proves the peer is the MISP instance, so anyone able to intercept
# the path could capture MISP_AUTH_API_KEY and rewrite the feed. That is the
# same trust level as running with http://.
#
# Prefer installing the CA on the worker host and setting this to false. The
# image ships ca-certificates for exactly that. This also only applies to the
# MISP client, so it does not weaken any other HTTPS connection.
# MISP_TLS_SKIP_VERIFY=true

# Total budget for confirming the imported events are present. It has to stay
# well inside OPERATION_TIMEOUT, because the download, extraction and directory
# swap all happen first; startup is refused if it does not.
# MISP_VERIFY_TIMEOUT=10m

# Pause between event-presence checks. Also the floor on how often MISP is
# polled, so it should not be shorter than a few seconds for a large feed.
# MISP_VERIFY_INTERVAL=15s
