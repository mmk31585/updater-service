# Application
APP_NAME=node-service
APP_ENV=development
GIN_MODE=debug

# Elasticsearch
ELASTIC_ENABLED=true
ELASTIC_URL=http://localhost:9200
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTIC_USER=elastic
ELASTIC_PASSWORD=changeme
ELASTIC_INDEX_PREFIX=file-service-operation-completed
ELASTIC_WORKERS=2
ELASTIC_CHANNEL_CAP=1000
ELASTIC_FLUSH_BYTES=5242880
ELASTIC_FLUSH_INTERVAL=5s
ELASTIC_MAX_RETRIES=5
ELASTIC_DLQ_PATH=/tmp/update/es-dead-letter

# HTTP Server
HTTP_HOST=localhost
HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# Database (MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=file_service
DB_USER=app
DB_PASSWORD=secret
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=5s

# NATS
NATS_URL=nats://localhost:4222
NATS_CONNECT_TIMEOUT=5s
NATS_RECONNECT_WAIT=2s
NATS_MAX_RECONNECTS=-1
NATS_DRAIN_TIMEOUT=10s
NATS_STREAM_NAME=FILE_SERVICE

# Node
NODE_ID=node-1
NODE_ROLE=entry
NODE_HEARTBEAT_INTERVAL=5s
NODE_HEARTBEAT_TIMEOUT=15s

# File Transfer
FILE_STAGING_DIR=./data/transfers
FILE_CHUNK_SIZE=1MiB
FILE_MAX_SIZE=20GiB
FILE_TRANSFER_TIMEOUT=30m
FILE_CHUNK_ACK_TIMEOUT=10s
FILE_TUSD_UPLOAD_DIR=./data/uploads
FILE_TUSD_MAX_SIZE=20GiB
FILE_TUSD_BASE_PATH=/uploads
FILE_TUSD_NOTIFY_TIMEOUT=10s
FILE_DOWNLOAD_CONCURRENCY=4
FILE_DOWNLOAD_CHUNK_SIZE=64MiB
FILE_DOWNLOAD_MAX_RETRIES=3

# Operation
OPERATION_TIMEOUT=30m
COMMAND_ACK_TIMEOUT=10s
PROCESSING_TIMEOUT=10m

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Services
SERVICES_ROOT=/app/services
# Optional per-service health URL overrides (defaults target the Docker network).
# Set these when the worker runs outside Docker, e.g.:
# HEALTH_URL_DATA_SERVICE=http://localhost:8081/health

# Health Check
HEALTH_CHECK_TIMEOUT=15s
HEALTH_REQUEST_TIMEOUT=2s
RETRY_INITIAL_DELAY=1s
RETRY_MAX_DELAY=4s
MAX_HEALTH_RETRIES=3
HEALTH_CHECK_INTERVAL=0
